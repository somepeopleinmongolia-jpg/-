{
  "hosting": {
    "public": "public",
    "predeploy": ["node tools/build.js"],
    "cleanUrls": true,
    "headers": [
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/og.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "/vendor/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "/cine.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
